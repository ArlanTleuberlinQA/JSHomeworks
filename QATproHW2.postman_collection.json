				{
					"name": "Sing up",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const timestamp = new Date().getTime();\r",
									"\r",
									"\r",
									"\r",
									"pm.collectionVariables.set(\"uniqueEmail\", `user_${timestamp}@example.com`);\r",
									"var pass = pm.variables.replaceIn('{{$randomFirstName}}'+12345)\r",
									"pm.collectionVariables.set(\"password\", pass);\r",
									"pm.collectionVariables.set(\"URL\",JSON.stringify(pm.iterationData.set(\"URL\")))\r",
									"const variablesToSet = [\"name\", \"lastName\", \"email\", \"password1\", \"repeatPassword\"];\r",
									"variablesToSet.forEach(variable => {\r",
									"    pm.variables.set(variable, JSON.stringify(pm.iterationData.get(variable)));\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"var req = JSON.parse(pm.request.body.raw)\r",
									"let resp = pm.response.json();\r",
									"\r",
									"\r",
									"const schema = {\r",
									"    \"type\": \"object\",\r",
									"    \"properties\": {\r",
									"        \"status\": { \"type\": \"string\" },\r",
									"        \"data\": {\r",
									"            \"type\": \"object\",\r",
									"            \"properties\": {\r",
									"                \"userId\": { \"type\": \"integer\" },\r",
									"                \"photoFilename\": { \"type\": \"string\" },\r",
									"                \"distanceUnits\": { \"type\": \"string\" },\r",
									"                \"currency\": { \"type\": \"string\" }\r",
									"            },\r",
									"            \"required\": [\"userId\", \"photoFilename\", \"distanceUnits\", \"currency\"]\r",
									"        }\r",
									"    },\r",
									"    \"required\": [\"status\", \"data\"]\r",
									"};\r",
									"\r",
									"\r",
									"\r",
									"\r",
									"\r",
									"if (pm.response.code === 201){\r",
									"pm.test('Response should be valid and have correct schema', function() {\r",
									"    const jsonData = pm.response.json();\r",
									"    pm.expect(tv4.validate(jsonData, schema)).to.be.true;\r",
									"});\r",
									"var mail = req.email\r",
									"var pattern = /^[A-Za-z0-9]+(?:[\\._][A-Za-z0-9]+)?@[a-z]+\\.[a-z]+$/\r",
									"pm.test('Email verification',function(){\r",
									"    pm.expect(pattern.test(mail)).to.be.true;\r",
									"})\r",
									"pm.collectionVariables.set(\"userId\",resp.data.userId)}\r",
									"else{\r",
									"    pm.test('Response shoud be 400', function() {\r",
									"    pm.response.to.have.status(400)})\r",
									"    postman.setNextRequest(null)\r",
									"    }\r",
									"\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\r\n\"name\": {{name}},\r\n\"lastName\":{{lastName}},\r\n\"email\": {{email}},\r\n\"password\":{{password1}},\r\n\"repeatPassword\": {{repeatPassword}}\r\n}"
						},
						"url": {
							"raw": "{{URL}}/auth/signup",
							"host": [
								"{{URL}}"
							],
							"path": [
								"auth",
								"signup"
							]
						}
					},
					"response": []
				},
				{
					"name": "Edit profile",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"function generateRandomDate() {\r",
									"    var startYear = 1910;\r",
									"    var endYear = 2023;\r",
									"    var year = Math.floor(Math.random() * (endYear - startYear + 1)) + startYear;\r",
									"    var month = Math.floor(Math.random() * 12) + 1; \r",
									"    var day = Math.floor(Math.random() * 28) + 1; \r",
									"\r",
									"    var date = new Date(year, month - 1, day); \r",
									"    return date;\r",
									"}\r",
									"\r",
									"var randomDate = generateRandomDate();\r",
									"pm.collectionVariables.set(\"bDate\", randomDate)\r",
									"\r",
									"var newName = pm.variables.replaceIn(\"{{$randomFirstName}}\")\r",
									"var newLastName = pm.variables.replaceIn(\"{{$randomLastName}}\")\r",
									"pm.collectionVariables.set(\"newName\",newName)\r",
									"pm.collectionVariables.set(\"newLastName\",newLastName)"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Response contains updated values', function() {\r",
									"    const jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.data.name).to.eql(pm.variables.get(\"newName\"));\r",
									"    pm.expect(jsonData.data.lastName).to.eql(pm.variables.get(\"newLastName\"));\r",
									"    pm.expect(jsonData.data.dateBirth).to.eql(pm.variables.get(\"bDate\"));\r",
									"\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
